<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Every XML file in db/changelog/changes/ is included automatically, in alphabetical order. -->
    <!-- Prefix new files with a number (002-..., 003-...) to fix their order. -->
    <!-- Never edit a changeSet that has been applied, and never rename or move its file. -->
    <includeAll path="db/changelog/changes/"/>

</databaseChangeLog>
